# Copy to .env.local for `npm run dev` and `npm run dev:supabase`.
# The anon key is public. Never put the service role key in a VITE_ variable.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Set to 0 to turn off the local mock picker while Supabase is unset.
# A production build ignores this and will not enter mock mode.
# VITE_AUTH_MOCK=0

# Local scripts only (npm run storage:upload, npm run content:sync).
# Do not set this in Netlify.
# SUPABASE_SERVICE_ROLE_KEY=
